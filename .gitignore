# ──────────────────────────────────────────────────────────────────────────────
# LifeLink — .gitignore
# ──────────────────────────────────────────────────────────────────────────────

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
client/node_modules/
server/node_modules/

# ── Production Build Outputs ──────────────────────────────────────────────────
dist/
build/
client/dist/
client/build/
server/dist/
server/build/

# ── Environment Variables & Secrets (NEVER commit .env files) ─────────────────
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example
client/.env
client/.env.*
!client/.env.example

# ── Test Coverage ─────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── IDE & Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ── OS Files ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Logs & Debug ─────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Local DB files ────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
data/

# ── Misc ─────────────────────────────────────────────────────────────────────
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
