# LifeLink Server Environment Configuration
# Copy this file to .env and configure your credentials

# Server Port
PORT=5000

# JWT Secret - used to sign and verify auth tokens
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Connection String
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
# Set to 'memory' to use temporary in-memory database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority

# Node Environment
NODE_ENV=development
