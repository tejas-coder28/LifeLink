# LifeLink Server Environment Configuration
# Copy this file to .env and configure your credentials

# Server Port
PORT=5000

# JWT Secret - used to sign and verify auth tokens
JWT_SECRET=your_jwt_secret_key_here

# Firebase Configuration
# Path to your Firebase service account JSON key file (relative to server directory or absolute)
# Download from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# (Optional) Offline in-memory mode: set to 'true' to run locally without a Firebase service account
# USE_IN_MEMORY_DB=true

# Node Environment
NODE_ENV=development
